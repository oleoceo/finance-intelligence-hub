[Unit]
Description=Finance Hub Lab weekly integrity check
OnFailure=finance-hub-lab-alert@weekly.service

[Service]
Type=oneshot
User=finance-backup
Group=finance-backup
EnvironmentFile=/etc/finance-hub/backup-lab-p06.env
ExecStart=/usr/bin/bash /opt/finance-hub/scripts/backup/finance-hub-lab-scheduled.sh weekly-check
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/apps/backups
