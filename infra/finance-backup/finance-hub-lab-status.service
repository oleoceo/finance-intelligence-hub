[Unit]
Description=Finance Hub Lab off-site freshness status
OnFailure=finance-hub-lab-alert@stale.service

[Service]
Type=oneshot
User=leoceo
Group=leoceo
EnvironmentFile=/etc/finance-hub/backup-lab-p06.env
ExecStart=/usr/bin/bash /opt/apps/apps/lab/finance-hub-p06/scripts/backup/finance-hub-lab-scheduled.sh status
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/apps/backups
